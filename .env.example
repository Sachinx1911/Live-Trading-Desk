# Copy to .env and adjust. Every variable the platform reads is listed here.
# Never put broker API secrets here: they are stored encrypted in the database.

# --- Environment -------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true in production (structured JSON logs)

# --- Database (PostgreSQL + TimescaleDB) --------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
POSTGRES_PORT=5433                 # 5433: many Macs already run a Postgres on 5432
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5433/trading
DATABASE_URL_SYNC=postgresql+psycopg://trading:trading@localhost:5433/trading   # Alembic

# --- Redis (quotes cache, pub/sub, arq jobs, kill switch flags) --------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3: Parquet archive, backups) --------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=trading-archive

# --- Security ----------------------------------------------------------------
# 32-byte url-safe base64 key for encrypting broker credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
# Secret for signing JWTs. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ACCESS_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TTL_SECONDS=1209600  # 14 days

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Market data collection (ADR-010) -----------------------------------------
COLLECT_RAW_TICKS=false          # raw tick/depth archive to Parquet; off by default

# --- Providers (public identifiers only; secrets live encrypted in the DB) -----
DEFAULT_MARKET_DATA_PROVIDER=fake   # fake | upstox | dhan

# --- AI ----------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=                  # leave empty in development; AI features show "not configured"
AI_DAILY_TOKEN_BUDGET=2000000

# --- Notifications -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web (Next.js) -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Local dev seed (optional) ------------------------------------------------
# Used only by `make seed-owner`; pick anything locally, never reuse a real password.
DEV_OWNER_EMAIL=owner@example.com
DEV_OWNER_PASSWORD=
# Separate database for migration tests (they upgrade and downgrade it); create with:
#   docker compose exec db psql -U trading -d trading -c "CREATE DATABASE trading_test;"
TEST_DATABASE_URL_SYNC=postgresql+psycopg://trading:trading@localhost:5433/trading_test
